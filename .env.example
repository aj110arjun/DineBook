# Public backend origin. Leave empty when /api is served through the same origin.
VITE_API_URL=

# Development only: backend destination for Vite's /api proxy.
DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# Public location service endpoints (defaults shown).
VITE_GEOCODING_BASE_URL=https://photon.komoot.io
VITE_POSTAL_API_BASE_URL=https://api.postalpincode.in
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'

# Google OAuth and payment secrets belong in the backend environment only.
